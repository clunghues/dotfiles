{{- $ids := includeTemplate "app-ids" . | trim | splitList "\n" -}}
{{- $os := .chezmoi.os -}}
{{- $key := "windows" }}{{ if eq $os "darwin" }}{{ $key = "darwin" }}{{ end -}}
# Manual installs for "{{ .machine }}" ({{ $os }})

Generated by chezmoi from .chezmoidata/apps.yaml. These apps are not installed by a package manager on this OS.
{{ range $ids }}
{{- $id := . }}
{{- $app := index $.apps $id }}
{{- $name := index $app "name" | default $id }}
{{- $cfg := index $app $key }}
{{- if $cfg }}
{{- if eq $cfg.provider "manual" }}
- [ ] {{ $name }}{{ with index $cfg "url" }} - {{ . }}{{ end }}{{ with index $cfg "note" }} ({{ . }}){{ end }}
{{- else if eq $cfg.provider "scoop" }}
- [ ] {{ $name }} - scoop install {{ with index $cfg "bucket" }}{{ . }}/{{ end }}{{ $cfg.package }} (scoop is not applied automatically yet)
{{- end }}
{{- end }}
{{- end }}

## Not configured for {{ $os }}

Apps in this machine's profiles that have no {{ $os }} entry in apps.yaml (OS-specific by design, or still to be added).
{{ range $ids }}
{{- $app := index $.apps . }}
{{- if not (index $app $key) }}
- {{ index $app "name" | default . }}
{{- end }}
{{- end }}
