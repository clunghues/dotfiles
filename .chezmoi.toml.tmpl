{{- /* Prompt text is deliberately just "machine" so `chezmoi init --promptString machine=pc` works non-interactively. */ -}}
{{- $machine := promptStringOnce . "machine" "machine" -}}
[data]
    machine = {{ $machine | quote }}
{{ if eq .chezmoi.os "windows" }}
[interpreters.ps1]
    command = "powershell.exe"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
{{ end -}}
